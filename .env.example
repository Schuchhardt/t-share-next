# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The project the tshare_* tables live in. Settings -> API in the dashboard.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Service role key. It bypasses row-level security, which is the point: this
# app runs no RLS policies and the Next.js server is the only client. Never
# expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Only for `npm run db:clone`, which copies the tshare_* tables into a project
# of their own. Point these at the destination and leave them blank otherwise;
# nothing in the app reads them.
NEW_SUPABASE_URL=
NEW_SUPABASE_SERVICE_ROLE=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# S3 (not migrated — the existing bucket keeps serving the old files)
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional, and easy to get wrong. Set it ONLY when the bucket is fronted by a
# CDN or is genuinely public-read: the app then hands out that URL unsigned and
# skips the signing round-trip. Point it at a private bucket and every image and
# every download on the site answers 403 — check with:
#   curl -o /dev/null -w '%{http_code}' "$S3_PUBLIC_BASE_URL/<una key cualquiera>"
# The production bucket is private, so leave this empty and let the app sign a
# temporary URL, the way the Laravel API did.
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# One-off data migration (npm run db:migrate)
# ---------------------------------------------------------------------------
LEGACY_EXPORT_DIR=../t-share-back/db_export_backup2026

# ---------------------------------------------------------------------------
# Correo (Resend)
# ---------------------------------------------------------------------------
# Sin esta key la aplicación no falla: registra el correo en consola y sigue.
# Se crea en Resend -> API Keys, con permiso de envío.
RESEND_API_KEY=

# El remitente. Tiene que estar en el dominio verificado en Resend
# (email.t-share.org), o el envío se rechaza. Es un subdominio a propósito: su
# SPF y su DKIM no tocan el MX de t-share.org, donde el equipo lee su correo.
RESEND_EMAIL_ADDRESS=comunidad@email.t-share.org
MAIL_FROM_NAME=T-share

# A dónde llega la respuesta si alguien contesta el correo. El subdominio de
# envío no tiene buzón, así que apunta al que sí se lee.
MAIL_REPLY_TO=comunidad@t-share.org

# El origen canónico del sitio. Con él se arman los enlaces de los correos y
# también los canonical, el sitemap y las imágenes de Open Graph, así que en
# producción tiene que ser el dominio real: si queda mal, Google indexa ese
# otro. En local apunta a http://localhost:9796 para que el enlace de
# recuperación funcione.
APP_URL=https://t-share.org
